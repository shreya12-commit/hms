
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 24px;
    font-family: Arial, sans-serif;
    background: #f4f6f9;
    color: #243047;
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding: 16px;
    background: #172554;
    border-radius: 8px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

h1, h2, h3 {
    color: #172554;
}

a {
    color: #2563eb;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

th, td {
    padding: 12px;
    border: 1px solid #e2e8f0;
    text-align: left;
}

th {
    background: #e8eef9;
}

button, input, select {
    padding: 10px;
    border-radius: 5px;
}

button {
    background: #2563eb;
    color: white;
    border: none;
    cursor: pointer;
}
